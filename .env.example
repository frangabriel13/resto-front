# URL de la API (resto-api). Si falta, se usa http://localhost:3001. En la imagen de Docker es obligatoria.
# - El proxy de /api/* (next.config.ts) la lee al hacer el build.
# - El cliente del servidor (lib/api/server.ts) la lee al correr.
API_URL=http://localhost:3001

# Dominio público del sitio: es la URL que se graba en el chip NFC y en el QR de cada pieza.
# Si falta, se usa http://localhost:3002. En producción tiene que ser el dominio definitivo.
PUBLIC_SITE_URL=http://localhost:3002

# Sentry: sin DSN queda apagado. Es el mismo DSN para el navegador y el servidor (es público)
# y queda fijo al hacer el build. Con REQUIRE_SENTRY_DSN=true el build falla si falta (la imagen
# de Docker lo pone así por defecto).
# NEXT_PUBLIC_SENTRY_DSN=
# REQUIRE_SENTRY_DSN=
# Si falta, se usa NODE_ENV (en la imagen, "production").
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Proporción de trazas de rendimiento, entre 0 y 1 (0 por defecto).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Solo al hacer el build: la release (el commit que despliega Coolify) y la subida de los source
# maps (sin el token no se suben; en la imagen va como secreto de build).
# SOURCE_COMMIT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
